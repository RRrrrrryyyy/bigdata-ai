# ============================================================
# 敏感信息（最高优先级：API Key / 密码 / 证书 / 凭据）
# ============================================================
# 环境变量与密钥配置
.env
.env.*
*.env
!.env.example
!.env.sample

# 密钥与证书文件
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
*.ppk

# 凭据/令牌命名的文件（兜底，含各类命名习惯）
*credential*
*credentials*
*secret*
*secrets*
*.secret
*token*.json
*apikey*
*api_key*
*api-key*
service-account*.json
gcp-key*.json
auth.json
.netrc
.npmrc
.pypirc

# 密码文件
*.passwd
*.password
passwords.txt
shadow

# 云平台/工具凭据目录
.aws/
.azure/
.gcloud/
.ssh/
.kube/config
.docker/config.json

# ============================================================
# 日志与运行时产物（可能夹带令牌、请求内容）
# ============================================================
*.log
logs/
*.sqlite
*.db-journal
*.tmp
*.bak
*.swp
*.swo
*~

# ============================================================
# 操作系统文件
# ============================================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# 编辑器与 IDE
# ============================================================
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
.project
.classpath
.settings/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
pip-log.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Node.js
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================================
# 构建与缓存产物
# ============================================================
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
coverage/

# ============================================================
# 工作区私有数据
# ============================================================
# 个人记忆日志不随仓库分发；skills 保留（属项目资产）
.workbuddy/memory/
