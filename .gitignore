# ============================================================
# .gitignore — bigdata-ai 仓库
# 重点：排除 API Key、密码、令牌等敏感信息
# ============================================================

# ---------- 敏感信息 / 密钥文件（最高优先级） ----------
# 环境变量文件（最常被误提交的泄密源头）
.env
.env.*
!.env.example

# 各类密钥与证书
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
*.ssh
known_hosts

# 通用密钥/凭据命名（显式文件名兜底）
secrets.*
credentials.*
secret_key*
service-account*.json
firebase-adminsdk*.json

# API 配置文件（可能内嵌 Key）
config/local.*
**/config/production.*
apikey*.txt
token*.txt

# 密码管理器与数据库转储
*.kdbx
*.kdbx.*
*.sql
*.dump
*.bak

# ---------- 会话 / 日志（可能含运行时泄露的凭据） ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
session*
*.session

# ---------- 系统与编辑器 ----------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
# Linux
*~
.fuse_hidden*
.directory
.Trash-*
# 编辑器 / IDE
.vscode/
!.vscode/settings.json
.idea/
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
instance/
.webassets-cache

# ---------- Node.js ----------
node_modules/
.npm/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
package-lock.json.bak

# ---------- 其他常见技术栈 ----------
# Java
*.class
*.jar
hs_err_pid*
# Docker（env 文件常含密码）
docker-compose.override.yml
.docker/
# Terraform（state 文件含明文凭据）
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example
crash.log

# ---------- 项目私有目录 ----------
# WorkBuddy 个人记忆日志（含个人工作记录，不随仓库分发）
# 注意：.workbuddy/skills/ 保留在仓库中（技能定义需团队共享）
.workbuddy/memory/
.workbuddy/plugins/
.workbuddy/cache/

# 临时文件
*.tmp
*.temp
*.swp
.cache/
tmp/
